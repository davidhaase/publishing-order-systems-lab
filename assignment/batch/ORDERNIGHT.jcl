//ORDEROUT DD DSN=ORDERS.NORMALIZED,DISP=(NEW,CATLG,DELETE)
//STEP02   EXEC PGM=ORDVALID
//ORDERIN  DD DSN=ORDERS.NORMALIZED,DISP=SHR
//RESULTS  DD DSN=ORDERS.RESULTS,DISP=(NEW,CATLG,DELETE)
