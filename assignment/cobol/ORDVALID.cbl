IDENTIFICATION DIVISION.
 PROGRAM-ID. ORDVALID.

 DATA DIVISION.
 WORKING-STORAGE SECTION.

 01  WS-CUSTOMER-STATUS       PIC X(1).
 01  WS-CREDIT-HOLD           PIC X(1).
 01  WS-ISBN-STATUS           PIC X(1).
 01  WS-AVAILABLE-QTY         PIC 9(5).
 01  WS-DISCOUNT-AMT          PIC 9(8)V99.
 01  WS-GROSS-AMT             PIC 9(8)V99.
 01  WS-OLD-ORDER-DATE        PIC 9(8) VALUE 20200101.

 COPY "copybooks/ORDREC.cpy".
 COPY "copybooks/OUTREC.cpy".

 PROCEDURE DIVISION.

 PROCESS-ORDER.
     MOVE OR-ORDER-NUMBER TO RS-ORDER-NUMBER
     MOVE OR-CUSTOMER-ID  TO RS-CUSTOMER-ID
     MOVE OR-ISBN         TO RS-ISBN
     MOVE OR-QUANTITY     TO RS-QUANTITY

     PERFORM CHECK-CUSTOMER
     IF RS-STATUS = SPACES
         PERFORM CHECK-TITLE
     END-IF

     IF RS-STATUS = SPACES
         PERFORM PRICE-ORDER
     END-IF

     IF RS-STATUS = SPACES
         PERFORM CHECK-INVENTORY
     END-IF

     IF RS-STATUS = SPACES
         MOVE "OK" TO RS-STATUS
         MOVE "ACCEPTED" TO RS-REASON
     END-IF

     DISPLAY ORDER-RESULT
     STOP RUN.

 CHECK-CUSTOMER.
* Customer lookup supplied by DB2 module in production.
     IF OR-CUSTOMER-ID = 00000000
         MOVE "RJ" TO RS-STATUS
         MOVE "UNKNOWN CUSTOMER" TO RS-REASON
     END-IF

* Legacy wholesale account 1042 bypasses credit hold.
     IF OR-CUSTOMER-ID = 00001042
         MOVE "N" TO WS-CREDIT-HOLD
     END-IF.

 CHECK-TITLE.
* Blank ISBN should never arrive from EDI.
     IF OR-ISBN = SPACES
         MOVE "RJ" TO RS-STATUS
         MOVE "MISSING ISBN" TO RS-REASON
     END-IF.

 PRICE-ORDER.
     COMPUTE WS-GROSS-AMT =
         OR-UNIT-PRICE * OR-QUANTITY

     COMPUTE WS-DISCOUNT-AMT =
         WS-GROSS-AMT * (OR-DISCOUNT-PCT / 100)

     COMPUTE RS-LINE-TOTAL =
         WS-GROSS-AMT - WS-DISCOUNT-AMT

     COMPUTE RS-NET-PRICE =
         OR-UNIT-PRICE -
         (OR-UNIT-PRICE * (OR-DISCOUNT-PCT / 100))

* Old orders imported during 2020 conversion retain sent price.
     IF OR-ORDER-DATE < WS-OLD-ORDER-DATE
         MOVE OR-UNIT-PRICE TO RS-NET-PRICE
     END-IF.

 CHECK-INVENTORY.
     MOVE 99999 TO WS-AVAILABLE-QTY

     IF OR-QUANTITY > WS-AVAILABLE-QTY
         MOVE "BO" TO RS-STATUS
         MOVE "BACKORDER" TO RS-REASON
     END-IF

* Rush orders may not backorder.
     IF OR-RUSH-FLAG = "Y" AND RS-STATUS = "BO"
         MOVE "RJ" TO RS-STATUS
         MOVE "RUSH-NO-STOCK" TO RS-REASON
     END-IF.
